# Copy this file to .env in the project root or load explicitly via python-dotenv

HUGGINGFACE_HUB_TOKEN=

# CUDA / BNB Config (optional)
# Specify which GPU(s) to use (e.g., "0" for GPU 0, "0,1" for GPUs 0 and 1)
# Leave empty to use all available GPUs
CUDA_VISIBLE_DEVICES=

# Optional: Whether to use 4-bit quantization via bitsandbytes (only affects Qwen if enabled in config)
# Set to "false" if you have enough VRAM and don't need 4-bit loading
# Note: This is mainly for reference - actual 4-bit loading is controlled by config.yaml
BNB_4BIT=false

